---
import BaseLayout from "@/layouts/BaseLayout.astro";

const links = [
  { label: "Book a call", href: "https://calendly.com/raulcano/meet", external: true },
  { label: "raul@zenex.dev", href: "mailto:raul@zenex.dev" },
  { label: "zenex.dev", href: "/" },
];
---
<BaseLayout>
  <section class="px-8 md:px-12 pt-24 pb-16 max-w-md mx-auto min-h-screen flex flex-col justify-center">
    <img src="/zenex-logo.svg" alt="Zenex" class="w-48" />

    <h1 class="text-2xl tracking-tighter font-light lg:text-4xl text-black mt-16">
      Hello.
    </h1>
    <p class="text-sm text-zinc-500 mt-4">
      Web app development and design for startups and small businesses.
    </p>

    <ul class="mt-12 space-y-2">
      {links.map(({ label, href, external }) => (
        <li>
          <a
            href={href}
            target={external ? "_blank" : undefined}
            rel={external ? "noopener" : undefined}
            class="flex items-center justify-between w-full px-5 h-12 rounded-full bg-white ring-1 ring-zinc-200 text-sm text-black hover:bg-transparent duration-200"
          >
            {label}
            <span class="text-zinc-400">→</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
